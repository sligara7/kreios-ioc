<?xml version="1.0" encoding="UTF-8"?>
<!--ARI Beamline 29-ID-2 Main Screen-->
<display version="2.0.0">
  <name>29ID2 Main - ARI</name>
  <macros>
    <Cell>29</Cell>
    <Sys>XF:29ID2</Sys>
  </macros>
  <width>1200</width>
  <height>900</height>
  <grid_step_x>6</grid_step_x>
  <grid_step_y>6</grid_step_y>

  <!-- Header Section with Title -->
  <widget type="rectangle" version="2.0.0">
    <name>Header Background</name>
    <width>1200</width>
    <height>80</height>
    <line_color>
      <color red="0" green="118" blue="177"/>
    </line_color>
    <background_color>
      <color red="0" green="118" blue="177"/>
    </background_color>
  </widget>

  <widget type="label" version="2.0.0">
    <name>Title</name>
    <text>ARI - Soft X-ray Photoemission and Scattering Imaging</text>
    <x>20</x>
    <y>10</y>
    <width>800</width>
    <height>30</height>
    <font>
      <font family="Liberation Sans" style="BOLD" size="20.0"/>
    </font>
    <foreground_color>
      <color red="255" green="255" blue="255"/>
    </foreground_color>
  </widget>

  <widget type="label" version="2.0.0">
    <name>Subtitle</name>
    <text>NSLS-II Beamline 29-ID-2</text>
    <x>20</x>
    <y>45</y>
    <width>400</width>
    <height>25</height>
    <font>
      <font family="Liberation Sans" style="REGULAR" size="16.0"/>
    </font>
    <foreground_color>
      <color red="200" green="220" blue="255"/>
    </foreground_color>
  </widget>

  <!-- Machine Status Bar -->
  <widget type="group" version="3.0.0">
    <name>Machine Status</name>
    <x>850</x>
    <y>10</y>
    <width>340</width>
    <height>60</height>
    <style>2</style>
    <foreground_color>
      <color red="255" green="255" blue="255"/>
    </foreground_color>

    <widget type="label" version="2.0.0">
      <name>Ring Current Label</name>
      <text>Ring:</text>
      <width>40</width>
      <height>25</height>
      <foreground_color>
        <color red="255" green="255" blue="255"/>
      </foreground_color>
    </widget>

    <widget type="textupdate" version="2.0.0">
      <name>Ring Current</name>
      <pv_name>SR:OPS-BI{DCCT:1}I:Real-I</pv_name>
      <x>45</x>
      <width>80</width>
      <height>25</height>
      <format>1</format>
      <precision>1</precision>
      <foreground_color>
        <color red="0" green="255" blue="0"/>
      </foreground_color>
      <background_color>
        <color red="40" green="40" blue="40"/>
      </background_color>
    </widget>

    <widget type="label" version="2.0.0">
      <name>mA Label</name>
      <text>mA</text>
      <x>130</x>
      <width>30</width>
      <height>25</height>
      <foreground_color>
        <color red="255" green="255" blue="255"/>
      </foreground_color>
    </widget>
  </widget>

  <!-- Detectors Section -->
  <widget type="group" version="3.0.0">
    <name>Detectors</name>
    <x>20</x>
    <y>100</y>
    <width>280</width>
    <height>200</height>
    <style>1</style>
    <font>
      <font family="Liberation Sans" style="BOLD" size="14.0"/>
    </font>
    <foreground_color>
      <color red="240" green="240" blue="240"/>
    </foreground_color>
    <line_color>
      <color red="0" green="118" blue="177"/>
    </line_color>

    <widget type="action_button" version="3.0.0">
      <name>KREIOS Button</name>
      <actions>
        <action type="open_display">
          <description>Open KREIOS Detector</description>
          <file>kreios.bob</file>
          <macros>
            <Sys>XF:29ID2-ES</Sys>
            <Dev>{Det:KREIOS}</Dev>
            <P>KREIOS:</P>
            <R>cam1:</R>
            <NAME>KREIOS-150</NAME>
            <Title>KREIOS-150 Momentum Microscope</Title>
          </macros>
          <target>tab</target>
        </action>
      </actions>
      <text>KREIOS-150 Momentum Microscope</text>
      <x>10</x>
      <y>10</y>
      <width>260</width>
      <height>35</height>
      <background_color>
        <color red="240" green="240" blue="240"/>
      </background_color>
      <tooltip>Open KREIOS detector controls</tooltip>
    </widget>

    <widget type="led" version="2.0.0">
      <name>KREIOS Connected</name>
      <pv_name>KREIOS:cam1:AsynIO.CNCT</pv_name>
      <x>10</x>
      <y>50</y>
      <width>20</width>
      <height>20</height>
    </widget>

    <widget type="label" version="2.0.0">
      <name>KREIOS Status Label</name>
      <text>KREIOS Connection</text>
      <x>35</x>
      <y>50</y>
      <width>150</width>
      <height>20</height>
    </widget>

    <widget type="textupdate" version="2.0.0">
      <name>KREIOS State</name>
      <pv_name>KREIOS:cam1:DetectorState_RBV</pv_name>
      <x>10</x>
      <y>75</y>
      <width>150</width>
      <height>20</height>
    </widget>
  </widget>

  <!-- Endstation Section -->
  <widget type="group" version="3.0.0">
    <name>Endstation</name>
    <x>320</x>
    <y>100</y>
    <width>280</width>
    <height>200</height>
    <style>1</style>
    <font>
      <font family="Liberation Sans" style="BOLD" size="14.0"/>
    </font>
    <foreground_color>
      <color red="240" green="240" blue="240"/>
    </foreground_color>
    <line_color>
      <color red="0" green="118" blue="177"/>
    </line_color>

    <widget type="label" version="2.0.0">
      <name>Endstation Info</name>
      <text>Sample Manipulator</text>
      <x>10</x>
      <y>10</y>
      <width>200</width>
      <height>25</height>
      <font>
        <font family="Liberation Sans" style="REGULAR" size="14.0"/>
      </font>
    </widget>

    <widget type="label" version="2.0.0">
      <name>Analyzer Info</name>
      <text>SPECS Analyzer System</text>
      <x>10</x>
      <y>40</y>
      <width>200</width>
      <height>25</height>
      <font>
        <font family="Liberation Sans" style="REGULAR" size="14.0"/>
      </font>
    </widget>
  </widget>

  <!-- Vacuum Section -->
  <widget type="group" version="3.0.0">
    <name>Vacuum</name>
    <x>620</x>
    <y>100</y>
    <width>280</width>
    <height>200</height>
    <style>1</style>
    <font>
      <font family="Liberation Sans" style="BOLD" size="14.0"/>
    </font>
    <foreground_color>
      <color red="240" green="240" blue="240"/>
    </foreground_color>
    <line_color>
      <color red="0" green="118" blue="177"/>
    </line_color>

    <widget type="label" version="2.0.0">
      <name>Vacuum Placeholder</name>
      <text>Vacuum System</text>
      <x>10</x>
      <y>10</y>
      <width>200</width>
      <height>25</height>
      <font>
        <font family="Liberation Sans" style="REGULAR" size="14.0"/>
      </font>
    </widget>

    <widget type="label" version="2.0.0">
      <name>Vacuum Note</name>
      <text>(Configure vacuum PVs)</text>
      <x>10</x>
      <y>40</y>
      <width>200</width>
      <height>25</height>
      <foreground_color>
        <color red="128" green="128" blue="128"/>
      </foreground_color>
    </widget>
  </widget>

  <!-- IOC Status Section -->
  <widget type="group" version="3.0.0">
    <name>IOC Status</name>
    <x>920</x>
    <y>100</y>
    <width>260</width>
    <height>200</height>
    <style>1</style>
    <font>
      <font family="Liberation Sans" style="BOLD" size="14.0"/>
    </font>
    <foreground_color>
      <color red="240" green="240" blue="240"/>
    </foreground_color>
    <line_color>
      <color red="0" green="118" blue="177"/>
    </line_color>

    <widget type="label" version="2.0.0">
      <name>KREIOS IOC Label</name>
      <text>KREIOS IOC:</text>
      <x>10</x>
      <y>10</y>
      <width>100</width>
      <height>20</height>
    </widget>

    <widget type="textupdate" version="2.0.0">
      <name>KREIOS Heartbeat</name>
      <pv_name>KREIOS:ioc:HEARTBEAT</pv_name>
      <x>115</x>
      <y>10</y>
      <width>80</width>
      <height>20</height>
    </widget>

    <widget type="led" version="2.0.0">
      <name>KREIOS IOC LED</name>
      <pv_name>KREIOS:ioc:HEARTBEAT</pv_name>
      <x>200</x>
      <y>10</y>
      <width>20</width>
      <height>20</height>
    </widget>

    <widget type="label" version="2.0.0">
      <name>Uptime Label</name>
      <text>Uptime:</text>
      <x>10</x>
      <y>35</y>
      <width>100</width>
      <height>20</height>
    </widget>

    <widget type="textupdate" version="2.0.0">
      <name>KREIOS Uptime</name>
      <pv_name>KREIOS:ioc:UPTIME</pv_name>
      <x>115</x>
      <y>35</y>
      <width>120</width>
      <height>20</height>
    </widget>
  </widget>

  <!-- Quick Status Section -->
  <widget type="group" version="3.0.0">
    <name>KREIOS Quick Status</name>
    <x>20</x>
    <y>320</y>
    <width>560</width>
    <height>250</height>
    <style>1</style>
    <font>
      <font family="Liberation Sans" style="BOLD" size="14.0"/>
    </font>
    <foreground_color>
      <color red="240" green="240" blue="240"/>
    </foreground_color>
    <line_color>
      <color red="0" green="118" blue="177"/>
    </line_color>

    <widget type="label" version="2.0.0">
      <name>Manufacturer Label</name>
      <text>Manufacturer:</text>
      <x>10</x>
      <y>10</y>
      <width>120</width>
      <height>25</height>
    </widget>

    <widget type="textupdate" version="2.0.0">
      <name>Manufacturer</name>
      <pv_name>KREIOS:cam1:Manufacturer_RBV</pv_name>
      <x>140</x>
      <y>10</y>
      <width>200</width>
      <height>25</height>
    </widget>

    <widget type="label" version="2.0.0">
      <name>Model Label</name>
      <text>Model:</text>
      <x>10</x>
      <y>40</y>
      <width>120</width>
      <height>25</height>
    </widget>

    <widget type="textupdate" version="2.0.0">
      <name>Model</name>
      <pv_name>KREIOS:cam1:Model_RBV</pv_name>
      <x>140</x>
      <y>40</y>
      <width>200</width>
      <height>25</height>
    </widget>

    <widget type="label" version="2.0.0">
      <name>Array Counter Label</name>
      <text>Frame Count:</text>
      <x>10</x>
      <y>70</y>
      <width>120</width>
      <height>25</height>
    </widget>

    <widget type="textupdate" version="2.0.0">
      <name>Array Counter</name>
      <pv_name>KREIOS:cam1:ArrayCounter_RBV</pv_name>
      <x>140</x>
      <y>70</y>
      <width>100</width>
      <height>25</height>
    </widget>

    <widget type="label" version="2.0.0">
      <name>Array Size Label</name>
      <text>Image Size:</text>
      <x>10</x>
      <y>100</y>
      <width>120</width>
      <height>25</height>
    </widget>

    <widget type="textupdate" version="2.0.0">
      <name>ArraySizeX</name>
      <pv_name>KREIOS:cam1:ArraySizeX_RBV</pv_name>
      <x>140</x>
      <y>100</y>
      <width>80</width>
      <height>25</height>
    </widget>

    <widget type="label" version="2.0.0">
      <name>X Label</name>
      <text>x</text>
      <x>225</x>
      <y>100</y>
      <width>20</width>
      <height>25</height>
      <horizontal_alignment>1</horizontal_alignment>
    </widget>

    <widget type="textupdate" version="2.0.0">
      <name>ArraySizeY</name>
      <pv_name>KREIOS:cam1:ArraySizeY_RBV</pv_name>
      <x>250</x>
      <y>100</y>
      <width>80</width>
      <height>25</height>
    </widget>

    <!-- Quick Acquire Controls -->
    <widget type="label" version="2.0.0">
      <name>Acquire Section</name>
      <text>Acquisition</text>
      <x>10</x>
      <y>140</y>
      <width>150</width>
      <height>25</height>
      <font>
        <font family="Liberation Sans" style="BOLD" size="14.0"/>
      </font>
    </widget>

    <widget type="action_button" version="3.0.0">
      <name>Start Button</name>
      <actions>
        <action type="write_pv">
          <pv_name>KREIOS:cam1:Acquire</pv_name>
          <value>1</value>
          <description>Start Acquire</description>
        </action>
      </actions>
      <text>Start</text>
      <x>10</x>
      <y>170</y>
      <width>100</width>
      <height>30</height>
      <background_color>
        <color red="200" green="255" blue="200"/>
      </background_color>
    </widget>

    <widget type="action_button" version="3.0.0">
      <name>Stop Button</name>
      <actions>
        <action type="write_pv">
          <pv_name>KREIOS:cam1:Acquire</pv_name>
          <value>0</value>
          <description>Stop Acquire</description>
        </action>
      </actions>
      <text>Stop</text>
      <x>120</x>
      <y>170</y>
      <width>100</width>
      <height>30</height>
      <background_color>
        <color red="255" green="200" blue="200"/>
      </background_color>
    </widget>

    <widget type="textupdate" version="2.0.0">
      <name>Acquire Status</name>
      <pv_name>KREIOS:cam1:Acquire</pv_name>
      <x>230</x>
      <y>170</y>
      <width>100</width>
      <height>30</height>
    </widget>
  </widget>

  <!-- Footer -->
  <widget type="label" version="2.0.0">
    <name>Footer</name>
    <text>ARI Beamline Control System - NSLS-II Brookhaven National Laboratory</text>
    <x>20</x>
    <y>860</y>
    <width>600</width>
    <height>25</height>
    <foreground_color>
      <color red="128" green="128" blue="128"/>
    </foreground_color>
  </widget>

</display>
