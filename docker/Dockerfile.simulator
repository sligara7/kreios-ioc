# Prodigy Simulator Docker Image
#
# Lightweight image for running the protocol simulator using UV
#
# Usage:
#   docker build -t kreios-simulator -f docker/Dockerfile.simulator .
#   docker run -it --rm -p 7010:7010 kreios-simulator

FROM python:3.11-slim

# Install UV
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

# Copy pyproject.toml, README, and source files
COPY pyproject.toml README.md /app/
COPY src/ /app/src/
COPY sim/ /app/sim/
COPY scripts/ /app/scripts/

# Install the package using UV (simulator has no external dependencies)
RUN uv pip install --system -e ".[sim]"

# Set working directory to sim folder for parameters.dat
WORKDIR /app/sim

# Expose simulator port
EXPOSE 7010

# Disable Python output buffering for real-time logs
ENV PYTHONUNBUFFERED=1

# Health check
HEALTHCHECK --interval=5s --timeout=3s --retries=3 \
    CMD python3 -c "import socket; s=socket.socket(); s.connect(('localhost', 7010)); s.close()" || exit 1

# Run the simulator using the installed CLI
CMD ["kreios-simulator"]
