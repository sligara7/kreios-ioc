# Test Runner Docker Image
#
# Runs pytest tests against the simulator and optionally the EPICS IOC
# Uses UV for fast dependency installation
#
# Usage:
#   docker build -t kreios-test -f docker/Dockerfile.test .
#   docker run -it --rm kreios-test pytest tests/ -v

FROM python:3.11-slim

# Install UV
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

# Copy pyproject.toml, README, and source files
COPY pyproject.toml README.md /app/
COPY src/ /app/src/
COPY sim/ /app/sim/

# Install the package with test and ophyd dependencies using UV
# Use --system to install into the system Python (no venv needed in Docker)
RUN uv pip install --system -e ".[test,ophyd,bluesky]"

# Copy test files (after dependencies to leverage cache)
COPY tests/ /app/tests/

# Create results directory
RUN mkdir -p /app/results

# Environment variables for test configuration
ENV SIMULATOR_HOST=localhost
ENV SIMULATOR_PORT=7010
ENV PYTHONUNBUFFERED=1

# Default command: run all tests
CMD ["pytest", "tests/", "-v", "--tb=short"]
